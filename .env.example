MM_ENVIRONMENT=local
MM_LOG_LEVEL=INFO
MM_DATABASE_URL=postgresql+psycopg://mathmodel:mathmodel@localhost:5432/mathmodel
MM_DEFAULT_PROVIDER=mock
MM_DEFAULT_PROVIDER_MODEL=mock-foundation
# Preferred Phase 8.1 route. Leave empty to retain the deprecated legacy pair above.
# MM_DEFAULT_MODEL_ID=deepseek-main
MM_PROVIDER_TIMEOUT_SECONDS=60
MM_PROVIDER_CONNECT_TIMEOUT_SECONDS=10
MM_PROVIDER_MAX_RESPONSE_BYTES=8388608
MM_ALLOW_LOCAL_MODEL_ENDPOINTS=false
MM_ALLOW_INSECURE_PROVIDER_TLS=false
# Optional server-side key for the Web UI encrypted credential bridge. Generate
# a random 32-byte value and encode it with URL-safe base64; never commit it.
# A new local database can start without this key; credential entry is disabled.
# Existing encrypted rows remain unavailable until their original key is restored.
# MM_SECRET_MASTER_KEY=
# JSON list of explicit Web UI origins. Wildcards are rejected.
MM_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]'
MM_REASONING_MAX_RETRIES=2
MM_AMBIGUITY_REVIEW_THRESHOLD=0.7
MM_STORAGE_ROOT=var/storage
MM_MAX_UPLOAD_BYTES=52428800
MM_MAX_ARCHIVE_ENTRIES=10000
MM_MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000
MM_MAX_ARCHIVE_COMPRESSION_RATIO=100
MM_MAX_IMAGE_PIXELS=50000000
MM_MAX_PDF_PAGES=500
MM_MAX_PDF_PAGE_IMAGES=10
MM_MAX_MULTIMODAL_INLINE_BYTES=18874368

# Build with: docker build -t mathmodel-ai-sandbox:phase3 sandbox
MM_SANDBOX_IMAGE=mathmodel-ai-sandbox:phase3
MM_SANDBOX_ROOT=var/sandbox
MM_SANDBOX_CPU_CORES=1
MM_SANDBOX_MEMORY_MB=512
MM_SANDBOX_TIMEOUT_SECONDS=30
MM_SANDBOX_PIDS_LIMIT=64
MM_SANDBOX_MAX_OUTPUT_BYTES=1000000
MM_SANDBOX_MAX_ARTIFACTS=50
MM_SANDBOX_MAX_ARTIFACT_BYTES=52428800
# Build with: docker build -f sandbox/solver.Dockerfile -t mathmodel-ai-solver:phase4 sandbox
MM_SOLVER_SANDBOX_IMAGE=mathmodel-ai-solver:phase4
MM_SOLVER_SANDBOX_ROOT=var/solver-sandbox
# Optional Gurobi image must contain the Phase 4 runtime and gurobipy.
# MM_GUROBI_SANDBOX_IMAGE=mathmodel-ai-gurobi:phase4
# MM_GUROBI_LICENSE_FILE=C:/secure/runtime/gurobi.lic
MM_LP_SOLVER_PREFERENCE='["SCIPY_HIGHS","GUROBI"]'
MM_MILP_SOLVER_PREFERENCE='["GUROBI","SCIPY_MILP","ORTOOLS_CP_SAT"]'
MM_INTEGER_SOLVER_PREFERENCE='["ORTOOLS_CP_SAT","GUROBI","SCIPY_MILP"]'
MM_NLP_SOLVER_PREFERENCE='["SCIPY_MINIMIZE"]'
MM_EVIDENCE_ABS_TOLERANCE=1e-9
MM_EVIDENCE_REL_TOLERANCE=1e-9
MM_VALIDATION_ABS_TOLERANCE=1e-7
MM_VALIDATION_REL_TOLERANCE=1e-7
MM_PHASE5_MAX_REPAIR_CYCLES=3
MM_SOLVER_TINY_MAX_VARIABLES=10
MM_SOLVER_TINY_MAX_CONSTRAINTS=10
MM_SOLVER_TINY_MAX_NONZEROS=100
MM_SOLVER_SMALL_MAX_VARIABLES=100
MM_SOLVER_SMALL_MAX_CONSTRAINTS=100
MM_SOLVER_SMALL_MAX_NONZEROS=2000
MM_SOLVER_MEDIUM_MAX_VARIABLES=1000
MM_SOLVER_MEDIUM_MAX_CONSTRAINTS=1000
MM_SOLVER_MEDIUM_MAX_NONZEROS=100000
MM_SOLVER_DEADLINE_PRESSURE_3_SECONDS=300
MM_SOLVER_DEADLINE_PRESSURE_4_SECONDS=120
MM_SOLVER_DEADLINE_PRESSURE_5_SECONDS=60

# Nested jury weights are configurable and must sum to 100.
MM_MODEL_JURY_WEIGHTS__PROBLEM_FIT=25
MM_MODEL_JURY_WEIGHTS__DATA_FIT=15
MM_MODEL_JURY_WEIGHTS__MATHEMATICAL_VALIDITY=15
MM_MODEL_JURY_WEIGHTS__EXPLAINABILITY=10
MM_MODEL_JURY_WEIGHTS__VALIDATION_POTENTIAL=10
MM_MODEL_JURY_WEIGHTS__INNOVATION_POTENTIAL=10
MM_MODEL_JURY_WEIGHTS__COMPETITION_FEASIBILITY=10
MM_MODEL_JURY_WEIGHTS__COMPUTATIONAL_COST=5

# Keep credentials only in the environment or a local untracked .env file.
MM_OPENAI_API_KEY=
MM_GOOGLE_API_KEY=
MM_ANTHROPIC_API_KEY=

# Paid acceptance tests additionally require an explicitly configured non-Mock
# MM_DEFAULT_PROVIDER / MM_DEFAULT_PROVIDER_MODEL and a matching credential.
# MM_RUN_LIVE_PROVIDER_TESTS=1

# Configurable-provider live gates. Values name models/endpoints only; never put
# a secret inside MM_TEST_CUSTOM_PROVIDER_CONFIG.
# DEEPSEEK_API_KEY=
# MM_TEST_DEEPSEEK_MODEL_ID=
# DASHSCOPE_API_KEY=
# QWEN_BASE_URL=
# MM_TEST_QWEN_MODEL_ID=
# MM_TEST_CUSTOM_PROVIDER_CONFIG={"provider": {...}, "model": {...}}
